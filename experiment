import random
import time
import csv
import matplotlib.pyplot as plt

from hybrid_sort import hybrid_sort, generate_data

# ---------------------------------------------------------------------------
# Config — adjust these once you and Person 1/3 agree on the actual values
# to use for the report (e.g. matching n used elsewhere for consistency).
# ---------------------------------------------------------------------------
FIXED_N = 1_000_000
MAX_VALUE = 10_000_000  # range [1, MAX_VALUE] for generated integers, matches Person 1's part (c)(i)
S_VALUES = [1, 2, 3, 5, 10, 20, 50, 100, 200, 500, 1000]
SEED = 42  # fixed seed so results are reproducible / comparable across runs
OUTPUT_CSV = "part_c_ii_results.csv"


def run_experiment():
    random.seed(SEED)
    arr = generate_data(FIXED_N, MAX_VALUE)

    results = []  # list of (S, comparisons, cpu_time_seconds)

    for S in S_VALUES:
        # Fresh copy each time since hybrid_sort sorts in place, and we
        # don't want one run's mutation to affect the next.
        arr_copy = arr.copy()

        start = time.perf_counter()
        comparisons = hybrid_sort(arr_copy, 0, len(arr_copy) - 1, S)
        elapsed = time.perf_counter() - start

        # Sanity check that the in-place sort actually worked
        assert arr_copy == sorted(arr), f"Output not sorted correctly for S={S}"

        results.append((S, comparisons, elapsed))
        print(f"S={S:>5} | comparisons={comparisons:>15,} | time={elapsed:.4f}s")

    return results


def save_csv(results):
    with open(OUTPUT_CSV, "w", newline="") as f:
        writer = csv.writer(f)
        writer.writerow(["S", "comparisons", "cpu_time_seconds"])
        writer.writerows(results)
    print(f"\nSaved results to {OUTPUT_CSV}")


def plot_results(results):
    S_list = [r[0] for r in results]
    comparisons_list = [r[1] for r in results]

    plt.figure(figsize=(8, 5))
    plt.plot(S_list, comparisons_list, marker="o")
    plt.xlabel("S (insertion sort threshold)")
    plt.ylabel("Number of key comparisons")
    plt.title(f"Key Comparisons vs. S (n = {FIXED_N:,})")
    plt.grid(True, alpha=0.3)
    plt.tight_layout()
    plt.savefig("part_c_ii_plot.png", dpi=150)
    print("Saved plot to part_c_ii_plot.png")
    # plt.show()  # uncomment if running interactively / locally


if __name__ == "__main__":
    results = run_experiment()
    save_csv(results)
    plot_results(results)
